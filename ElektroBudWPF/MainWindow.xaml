<Window x:Class="Elektro_Bud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elektro-Bud - Magazyn" Height="600" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Background="#FF2B579A" Orientation="Horizontal">
            <Label Content="ELEKTRO-BUD MAGAZYN" Foreground="White" FontSize="22" FontWeight="Bold" Margin="10"/>
            <Label Content="projekt szkolny WPF" Foreground="#FFD0D0D0" VerticalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Lista produktów w magazynie" Grid.Column="0" Margin="0,0,10,0">
                <!--AutoGenerateColumns="False" - to sami definiujemy kolumny i jeszcze CanUserAddRows="False" to żeby user nie dodawał pustego wiersza-->
                <DataGrid x:Name="dgProdukty" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="dgProdukty_SelectionChanged" Margin="5">
                    <DataGrid.Columns>
                        <!--Binding={Binding Id} to żeby brać dane z Id z Produktu -->
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                        <DataGridTextColumn Header="Nazwa produktu" Binding="{Binding Nazwa}" Width="*"/>
                        <DataGridTextColumn Header="Kategoria" Binding="{Binding Kategoria}" Width="130"/>
                        <DataGridTextColumn Header="Ilość" Binding="{Binding Ilosc}" Width="60"/>
                        <DataGridTextColumn Header="Cena" Binding="{Binding Cena}" Width="80"/>
                        <DataGridTextColumn Header="Dostawca" Binding="{Binding Dostawca}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header="Formularz produktu" Grid.Column="1">
                <StackPanel Margin="10">
                    <Label Content="Nazwa produktu:*"/>
                    <TextBox x:Name="txtNazwa" Height="28" ToolTip="Wpisz pełną nazwę produktu"/>

                    <Label Content="Kategoria:*" Margin="0,5,0,0"/>
                    <ComboBox x:Name="cmbKategoria" Height="28">
                        <ComboBoxItem Content="Kable i przewody"/>
                        <ComboBoxItem Content="Oświetlenie"/>
                        <ComboBoxItem Content="Gniazdka i wyłączniki"/>
                        <ComboBoxItem Content="Bezpieczniki"/>
                        <ComboBoxItem Content="Narzędzia"/>
                        <ComboBoxItem Content="Inne"/>
                    </ComboBox>

                    <Label Content="Ilość szt.:*" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtIlosc" Height="28" ToolTip="Wpisz liczbę np. 20"/>

                    <Label Content="Cena za szt. (zł):*" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtCena" Height="28" ToolTip="Np. 15,50 lub 15.50"/>

                    <Label Content="Dostawca:" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtDostawca" Height="28"/>

                    <!-- Troche walidacji -->
                    <TextBlock x:Name="txtBlad" Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"/>

                    <Button x:Name="btnDodaj" Content="DODAJ" Height="40" Background="#FF90EE90" FontWeight="Bold" FontSize="14" Margin="0,15,0,0" Click="btnDodaj_Click"/>
                    <Button x:Name="btnEdytuj" Content="ZAPISZ ZMIANY" Height="35" Background="#FF87CEEB" Margin="0,8,0,0" Click="btnEdytuj_Click"/>
                    <Button x:Name="btnUsun" Content="USUŃ ZAZNACZONY" Height="35" Background="#FFFF9999" Margin="0,8,0,0" Click="btnUsun_Click"/>
                    <Button Content="WYCZYŚĆ POLA" Height="28" Margin="0,8,0,0" Click="btnWyczysc_Click"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2">
            <TextBlock x:Name="txtStatus" Text="Gotowy"/>
        </StatusBar>
    </Grid>
</Window>
